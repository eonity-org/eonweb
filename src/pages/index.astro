---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products } from '../data/products';
const principles = [
  {
    number: '01',
    title: 'Structure first.',
    text: 'Schemas describe resources, a slicing tree describes a page, and a document has its own structure. Structure gives content meaning that people and AI can both read.',
    detail: 'Schemas · slicing trees · documents',
  },
  {
    number: '02',
    title: 'A scope for the AI.',
    text: 'Each tool gives the AI a defined area to work in and a set of named moves it may use there: a Vault, one block of a page, one part of a document.',
    detail: 'Scoped tools through MCP',
  },
  {
    number: '03',
    title: 'People in the loop.',
    text: 'The AI proposes and shows its work; you review, approve and undo. Every change is checked before it is applied, so nothing leaves its scope unnoticed.',
    detail: 'Review · approval · undo',
  },
];
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span>
        <span>
          <span class="eyebrow-category">Structure and meaning · </span>Open
          source · human in the loop
        </span>
      </p>
      <h1 id="hero-title">
        AI in a scope.
        <br />
        <span>You in the loop.</span>
      </h1>
      <p class="hero-description">
        Eonity builds open-source tools that give content structure and meaning,
        so people and AI can work on it together. Each tool hands the AI a clear
        scope and a set of moves it can make inside it.
      </p>
      <p class="hero-audience">
        TYDAL for digital assets. TYKERF for web pages. Tyset for documents,
        coming soon.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#products">
          Explore the tools <span aria-hidden="true">→</span>
        </a>
        <a
          class="text-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org"
        >
          Eonity on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <figure class="knowledge-model scope-model">
      <div class="model-header">
        <span class="eyebrow">Where the AI works</span>
        <span class="model-tag">TOOL → SCOPE → MOVES</span>
      </div>
      <ul class="scope-list">
        {products.map((product) => (
          <li
            class:list={[
              'scope-row',
              { 'scope-row-coming': product.status === 'coming' },
            ]}
          >
            <span class="scope-product">
              <strong>{product.name}</strong>
              <small>{product.category}</small>
            </span>
            <span class="scope-frame">
              <span class="scope-label">Scope</span>
              {product.scope}
            </span>
            <span class="scope-moves">{product.moves}</span>
          </li>
        ))}
      </ul>
      <div class="scope-person">
        <span class="scope-person-icon" aria-hidden="true"></span>
        <span>
          You review, approve and undo
          <small>Every move is validated and recorded</small>
        </span>
      </div>
      <figcaption>
        Three tools. One way of working. <span>Concept illustration</span>
      </figcaption>
    </figure>
  </section>
  <div class="principles-band">
    <div class="container">
      <span>
        <i aria-hidden="true"></i> Open source
      </span>
      <span>Structure & meaning</span>
      <span>Scoped AI · MCP</span>
      <span>Human in the loop</span>
    </div>
  </div>
  <section
    class="applications-section"
    id="products"
    aria-labelledby="products-title"
  >
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The Eonity tools</p>
          <h2 id="products-title">
            Different content.
            <br />
            The same way of working.
          </h2>
        </div>
        <p>
          Each tool understands one kind of content and gives the AI only the
          moves that make sense for it. They share a design language, an
          open-source license and the TY in their names.
        </p>
      </div>
      <div class="application-list product-list">
        {products.map((product, index) => (
          <article class="application product-card">
            <div class="application-label">
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <span class="eyebrow">{product.category}</span>
              {product.status === 'coming' && (
                <span class="product-badge">Coming soon</span>
              )}
            </div>
            <h3>
              {product.logo ? (
                <img
                  class="product-card-logo"
                  src={product.logo.src}
                  width={product.logo.width}
                  height={product.logo.height}
                  alt={product.name}
                />
              ) : (
                <span class="product-wordmark">
                  {product.name.toLowerCase()}
                </span>
              )}
            </h3>
            <p class="product-tagline">{product.tagline}</p>
            <p>{product.description}</p>
            <span class="application-category">
              AI scope: {product.scope.toLowerCase()}
            </span>
            <div class="application-links">
              {product.href ? (
                <a class="text-link" href={product.href}>
                  Discover {product.name} <span aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="product-soon">Arriving in the coming weeks</span>
              )}
              {product.github && (
                <a
                  class="text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Opens in a new tab"
                  href={product.github}
                >
                  {product.name} on GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section
    class="section container"
    id="approach"
    aria-labelledby="approach-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">How we build</p>
        <h2 id="approach-title">
          Structure and meaning,
          <br />
          for people and AI.
        </h2>
      </div>
      <p>
        AI is most useful when it knows what it is working on and where its work
        ends. Eonity tools make both explicit, so you can hand over real work
        and still keep the final say.
      </p>
    </div>
    <div class="benefits">
      {principles.map((item) => (
        <article>
          <span class="number">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="benefit-detail">{item.detail}</span>
        </article>
      ))}
    </div>
  </section>
  <section
    class="section container demo-section"
    id="see-it-work"
    aria-labelledby="demo-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">See it work</p>
        <h2 id="demo-title">
          The AI proposes.
          <br />
          You decide.
        </h2>
      </div>
      <p>
        Claude curating an exhibition through a TYDAL Vault, and Kaity building
        a TYKERF page block by block: the same scoped way of working.
      </p>
    </div>
    <div class="demo-grid">
      <figure class="demo-figure">
        <a
          class="demo-media"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens the video in a new tab"
          href="/images/claude-curates-drift.mp4"
        >
          <video
            src="/images/claude-curates-drift.mp4"
            width="1226"
            height="940"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Claude Desktop reads the six photographs of the Drift exhibition through TYDAL, proposes a title and description for each, asks permission to update them, and shows the table of new titles."
          ></video>
        </a>
        <figcaption>
          <strong>TYDAL.</strong> Claude reads an exhibition through its Vault,
          proposes titles and descriptions, and asks before it writes them back.
          <a class="inline-link" href="/tydal/#see-it-work">
            More about TYDAL
          </a>
        </figcaption>
      </figure>
      <figure class="demo-figure">
        <div class="demo-media demo-media-video">
          <video
            src="/tykerf-guides/videos/tykerf-builds-lisbon.mp4"
            poster="/tykerf-guides/videos/tykerf-builds-lisbon.jpg"
            width="1280"
            height="720"
            controls
            playsinline
            preload="none"
            aria-label="Kaity, TYKERF's assistant, builds a page about Lisbon from one sentence, block by block, with facts, trivia, games and illustrations."
          ></video>
        </div>
        <figcaption>
          <strong>TYKERF.</strong> One sentence on the start screen, and Kaity
          builds a page about Lisbon, one named block at a time (2:48).
          <a class="inline-link" href="/tykerf/">
            More about TYKERF
          </a>
        </figcaption>
      </figure>
    </div>
  </section>
  <section
    class="section container open-source-section"
    id="open-source"
    aria-labelledby="open-title"
  >
    <div>
      <p class="eyebrow">Built in the open</p>
      <h2 id="open-title">
        Good knowledge
        <br />
        deserves open tools.
      </h2>
    </div>
    <div>
      <p>
        Every Eonity tool is open source under the{' '}
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://www.apache.org/licenses/LICENSE-2.0"
        >
          Apache License 2.0
        </a>
        . Run them yourself, inspect the code and contribute to their
        development.
      </p>
      <p>
        They work with the AI you choose: connect Claude or another MCP client,
        and it gets the same scoped moves the tools use themselves.
      </p>
      <a
        class="text-link"
        target="_blank"
        rel="noopener noreferrer"
        title="Opens in a new tab"
        href="https://github.com/eonity-org"
      >
        Explore the repositories <span aria-hidden="true">↗</span>
      </a>
      <p>
        <a class="text-link" href="/about/">
          About Eonity <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</SiteLayout>
<script>
  const demoVideo = document.querySelector<HTMLVideoElement>(
    '.demo-figure video[autoplay]',
  );
  if (demoVideo && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Stay still; a click opens the video in a new tab, with the browser's controls.
    demoVideo.removeAttribute('autoplay');
    demoVideo.pause();
  }
</script>
