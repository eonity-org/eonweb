---
import SiteLayout from '../layouts/SiteLayout.astro';
const benefits = [
  {
    number: '01',
    title: 'Understand.',
    text: 'AI can suggest descriptions, tags and classifications from your content. Review those suggestions before applying them, or use configurable approval rules.',
    detail: 'AI enrichment with review',
  },
  {
    number: '02',
    title: 'Organize.',
    text: 'Keep an asset, its supporting files and representations together as a resource. Collection schemas define its metadata, file roles and indexing rules.',
    detail: 'Schema-driven collections',
  },
  {
    number: '03',
    title: 'Explore & publish.',
    text: 'Publish selected resources through Vaults with their own context and access rules. Reuse the same source across galleries, applications and AI connections.',
    detail: 'One source, multiple contexts',
  },
];
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> Open-source Semantic Asset Platform
      </p>
      <h1 id="hero-title">
        Control your
        <br />
        <span>knowledge flow.</span>
      </h1>
      <p class="hero-description">
        Tydal is the typed Digital Asset Layer. Turn documents, images, datasets
        and code into structured, searchable resources. Use schemas to define
        their meaning and Vaults to make selected content available to people,
        applications and AI agents.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/developers/getting-started/">
          Get started <span aria-hidden="true">↗</span>
        </a>
        <a
          class="text-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org/tydal"
        >
          View on GitHub <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-footnote">
        Your content. Your structure. Your choice of AI.
      </p>
    </div>
    <figure class="knowledge-model">
      <div class="model-header">
        <span class="eyebrow">Your knowledge flow</span>
        <span class="model-tag">RESOURCES → VAULTS</span>
      </div>
      <div class="repository-node">
        <div class="repository-heading">
          <div>
            <strong>Tydal repository</strong>
            <small>Your resources, structured and enriched</small>
          </div>
          <span class="repository-badge">CORE</span>
        </div>
        <div class="model-resources" aria-label="Input resources">
          <div class="resource">
            <span class="resource-icon document-icon" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span>
              Documents<small>Text & knowledge</small>
            </span>
          </div>
          <div class="resource">
            <span class="resource-icon image-icon" aria-hidden="true">
              <i></i>
            </span>
            <span>
              Images<small>Media & meaning</small>
            </span>
          </div>
          <div class="resource">
            <span class="resource-icon data-icon" aria-hidden="true">
              &#123; &#125;
            </span>
            <span>
              Data<small>Structure & context</small>
            </span>
          </div>
        </div>
        <div class="repository-properties">
          <span>Schemas</span>
          <span>AI enrichment</span>
          <span>Search</span>
        </div>
      </div>
      <div class="single-flow" aria-hidden="true"></div>
      <div class="vault-node">
        <div class="vault-top">
          <span class="vault-symbol" aria-hidden="true">
            ◈
          </span>
          <span>
            Vaults<small>Contextual views of your resources</small>
          </span>
          <span class="vault-light" aria-hidden="true"></span>
        </div>
        <div class="vault-properties">
          <span>Selected resources</span>
          <span>Context</span>
          <span>Access rules</span>
        </div>
      </div>
      <div class="flow-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div
        class="model-choices"
        role="group"
        aria-label="Explore how Vaults can be used"
      >
        <button type="button" aria-pressed="true" data-experience="people">
          <span aria-hidden="true">▦</span>People
        </button>
        <button type="button" aria-pressed="false" data-experience="apps">
          <span aria-hidden="true">⌘</span>Applications
        </button>
        <button type="button" aria-pressed="false" data-experience="ai">
          <span aria-hidden="true">✳</span>AI agents
        </button>
      </div>
      <p class="model-explanation" aria-live="polite">
        Publish selected resources as galleries and knowledge spaces.
      </p>
      <figcaption>
        One repository. Many experiences. <span>Concept illustration</span>
      </figcaption>
    </figure>
  </section>
  <div class="principles-band">
    <div class="container">
      <span>
        <i aria-hidden="true"></i> Open source
      </span>
      <span>Schema-driven</span>
      <span>API & MCP</span>
      <span>Provider-flexible AI</span>
    </div>
  </div>
  <section
    class="section container"
    id="platform"
    aria-labelledby="platform-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Beyond digital asset management</p>
        <h2 id="platform-title">
          From digital assets
          <br />
          to semantic knowledge.
        </h2>
      </div>
      <p>
        Typed means your resources follow schemas: fields, validation and search
        behavior are defined together. Find content by meaning, connect related
        resources and reuse them across different contexts.
      </p>
    </div>
    <div class="benefits">
      {benefits.map((item) => (
        <article>
          <span class="number">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="benefit-detail">{item.detail}</span>
        </article>
      ))}
    </div>
    <div class="model-summary">
      <span>Tydal repository</span>
      <b aria-hidden="true">→</b>
      <span>Contextual Vaults</span>
      <b aria-hidden="true">→</b>
      <span>Experiences</span>
      <a href="/about/#the-model">
        Meet the model <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section
    class="applications-section"
    id="applications"
    aria-labelledby="applications-title"
  >
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Built around Tydal</p>
          <h2 id="applications-title">
            One foundation.
            <br />
            Many ways to build.
          </h2>
        </div>
        <p>
          The same resources can support an exhibition, a learning application
          or an AI workflow. Vaults deliver selected content from the repository
          without duplicating the underlying assets.
        </p>
      </div>
      <div class="application-list">
        <article class="application">
          <div class="application-label">
            <span class="number">01</span>
            <span class="eyebrow">Full Frame</span>
          </div>
          <h3>
            Let your collection
            <br />
            take the stage.
          </h3>
          <p>
            Curated photographic exhibitions, browsing and jury workflows,
            connected to the resources in Tydal.
          </p>
          <span class="application-category">Exhibitions & photography</span>
        </article>
        <article class="application">
          <div class="application-label">
            <span class="number">02</span>
            <span class="eyebrow">AI connections</span>
          </div>
          <h3>
            Bring your AI
            <br />
            to your knowledge.
          </h3>
          <p>
            Connect external AI tools through MCP to explore the resources
            exposed by a Vault, including their content, metadata and
            relationships.
          </p>
          <span class="application-category">Agents & knowledge workflows</span>
        </article>
        <article class="application">
          <div class="application-label">
            <span class="number">03</span>
            <span class="eyebrow">Your application</span>
          </div>
          <h3>
            Make something
            <br />
            of your own.
          </h3>
          <p>
            Build an experience around your content using the API and SDK—from a
            resource library to a learning application.
          </p>
          <a class="text-link" href="#developers">
            Explore the connection <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
    </div>
  </section>
  <section
    class="developer-section"
    id="developers"
    aria-labelledby="developers-title"
  >
    <div class="container developer-grid">
      <div>
        <p class="eyebrow">For the people who build</p>
        <h2 id="developers-title">
          The semantic layer
          <br />
          between your files
          <br />
          and your AI.
        </h2>
        <p>
          Manage resources and collections through the repository API. Build
          applications against Vault interfaces, or connect AI agents through
          MCP. Each Vault controls the content and capabilities it exposes.
        </p>
        <a class="button button-light" href="/developers/">
          Explore developer docs <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="code-card">
        <div class="code-header">
          <span>
            <i></i> Read your Vault metadata
          </span>
          <button
            class="copy-button"
            type="button"
            aria-label="Copy Vault request"
          >
            Copy
          </button>
        </div>
        <pre><code id="vault-request"><span class="code-muted"># Use your instance’s Vault URL and key</span>
curl <span class="code-string">"$TYDAL_VAULT_URL/meta"</span> \
  -H <span class="code-string">"X-Vault-Key: $TYDAL_VAULT_KEY"</span></code></pre>
        <div class="code-bottom">
          <span>HTTP API</span>
          <span>Vault-scoped access</span>
        </div>
        <p class="copy-status" aria-live="polite"></p>
      </div>
    </div>
  </section>
  <section
    class="section container open-source-section"
    id="open-source"
    aria-labelledby="open-title"
  >
    <div>
      <p class="eyebrow">Built in the open</p>
      <h2 id="open-title">
        Good knowledge
        <br />
        deserves open tools.
      </h2>
    </div>
    <div>
      <p>
        Tydal is built for developers and early adopters who want to understand,
        adapt and extend the tools they use.
      </p>
      <p>
        Tydal is available under the{' '}
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org/tydal/blob/main/LICENSE"
        >
          Apache License 2.0
        </a>
        . Run your own instance, inspect the code and contribute to its
        development.
      </p>
      <a
        class="text-link"
        target="_blank"
        rel="noopener noreferrer"
        title="Opens in a new tab"
        href="https://github.com/eonity-org/tydal"
      >
        Explore the repository <span aria-hidden="true">↗</span>
      </a>
      <p>
        <a
          class="text-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org/tydal/blob/main/docs/CONTRIBUTING.md"
        >
          Read the contribution guide <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </section>
</SiteLayout>
<script>
  const explanations: Record<string, string> = {
    people: 'Publish selected resources as galleries and knowledge spaces.',
    apps: 'Build applications that access selected resources through the Vault API.',
    ai: 'Connect AI agents to selected resources through Vaults and MCP.',
  };
  const choiceButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-experience]');
  choiceButtons.forEach((button) => {
    button.addEventListener('click', () => {
      choiceButtons.forEach((item) =>
        item.setAttribute('aria-pressed', String(item === button)),
      );
      const description = document.querySelector('.model-explanation');
      if (description)
        description.textContent =
          explanations[button.dataset.experience ?? 'people'];
    });
  });
  document
    .querySelector<HTMLButtonElement>('.copy-button')
    ?.addEventListener('click', async () => {
      const source = document.querySelector('#vault-request')?.textContent;
      const status = document.querySelector('.copy-status');
      if (!source || !status) return;
      try {
        await navigator.clipboard.writeText(source);
        status.textContent = 'Request copied.';
      } catch {
        status.textContent = 'Select the request above to copy it.';
      }
    });
</script>
