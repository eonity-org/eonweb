---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products } from '../data/products';
// The foundation the three tools share.
const steps = [
  {
    number: '01',
    label: 'Structure',
    title: 'Content with a shape.',
    text: 'Schemas, named blocks, sections of a document. Structure gives every part a name that people and AI can both point at.',
  },
  {
    number: '02',
    label: 'Controlled scope',
    title: 'The AI gets only its area.',
    text: 'You choose what the AI may work on, and the tool allows it only the moves that make sense there: a Vault, a block, a section. Nothing outside it is touched.',
  },
  {
    number: '03',
    label: 'Human in the loop',
    title: 'You decide.',
    text: 'Every change is checked before it is applied, and you can review, approve or undo it. The AI does the work; the final say is yours.',
  },
];
---

<SiteLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span>
        <span>
          <span class="eyebrow-category">People and AI · </span>Open source ·
          human in the loop
        </span>
      </p>
      <h1 id="hero-title">
        People and AI,
        <br />
        <span>working together.</span>
      </h1>
      <p class="hero-description">
        Eonity builds open-source tools on one foundation: the AI works inside a
        scope you control, and you stay in the loop. You point at what matters,
        the AI does the work, you have the final say.
      </p>
      <p class="hero-audience">
        TYDAL for digital assets. TYKERF for web pages. TYSET for publications,
        coming in a few weeks.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#products">
          Explore the tools <span aria-hidden="true">→</span>
        </a>
        <a
          class="text-link"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org"
        >
          Eonity on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <figure class="knowledge-model scope-model">
      <div class="model-header">
        <span class="eyebrow">Three tools, one way of working</span>
        <span class="model-tag">SCOPE → AI → YOU REVIEW</span>
      </div>
      <ul class="scope-list">
        {products.map((product) => (
          <li
            class:list={[
              'scope-row',
              { 'scope-row-coming': product.status === 'coming' },
            ]}
          >
            <span class="scope-product">
              <strong>{product.name}</strong>
              <small>{product.category}</small>
            </span>
            <span class="scope-frame">
              <span class="scope-label">People + AI</span>
              {product.together}
            </span>
            <span class="scope-moves">
              AI scope: {product.scope.toLowerCase()}
            </span>
          </li>
        ))}
      </ul>
      <div class="scope-person">
        <span class="scope-person-icon" aria-hidden="true"></span>
        <span>
          You review, approve and undo
          <small>Every move is validated and recorded</small>
        </span>
      </div>
      <figcaption>
        Three tools. One way of working. <span>Concept illustration</span>
      </figcaption>
    </figure>
  </section>
  <section
    class="applications-section"
    id="products"
    aria-labelledby="products-title"
  >
    <div class="container section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The Eonity tools</p>
          <h2 id="products-title">
            Different content.
            <br />
            The same partnership.
          </h2>
        </div>
        <p>
          Each tool understands one kind of content and gives the AI only the
          moves that make sense for it.
        </p>
      </div>
      <div class="application-list product-list">
        {products.map((product, index) => (
          <article class="application product-card">
            <div class="application-label">
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <span class="eyebrow">{product.category}</span>
              {product.status === 'coming' && (
                <span class="product-badge">Coming soon</span>
              )}
            </div>
            <h3>
              {product.logo ? (
                <img
                  class="product-card-logo"
                  src={product.logo.src}
                  width={product.logo.width}
                  height={product.logo.height}
                  alt={product.name}
                />
              ) : (
                <span class="product-wordmark">
                  {product.name.toLowerCase()}
                </span>
              )}
            </h3>
            <p class="product-tagline">{product.tagline}</p>
            <p>{product.description}</p>
            <span class="application-category">
              AI scope: {product.scope.toLowerCase()}
            </span>
            <div class="application-links">
              {product.href && (
                <a class="text-link" href={product.href}>
                  {product.status === 'coming' ? 'Preview' : 'Discover'}{' '}
                  {product.name} <span aria-hidden="true">→</span>
                </a>
              )}
              {product.status === 'coming' && (
                <span class="product-soon">Arriving in a few weeks</span>
              )}
              {product.github && (
                <a
                  class="text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Opens in a new tab"
                  href={product.github}
                >
                  {product.name} on GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section
    class="section container"
    id="approach"
    aria-labelledby="approach-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">One foundation</p>
        <h2 id="approach-title">
          Every tool is built on
          <br />
          a controlled scope and you.
        </h2>
      </div>
      <p>
        AI is most useful when it knows what it is working on and where its work
        ends, and when a person stays in the loop. TYDAL, TYKERF and TYSET share
        this foundation.
      </p>
    </div>
    <div class="application-list start-list">
      {steps.map((item) => (
        <article class="application">
          <div class="application-label">
            <span class="number">{item.number}</span>
            <span class="eyebrow">{item.label}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
  <section
    class="section container demo-section"
    id="see-it-work"
    aria-labelledby="demo-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">See it work</p>
        <h2 id="demo-title">
          You point.
          <br />
          The AI does the work.
        </h2>
      </div>
      <p>
        Kaity working through a list of tasks on a TYKERF page, and Claude
        describing an exhibition through a TYDAL Vault: you stay in charge, the
        AI does the legwork.
      </p>
    </div>
    <div class="demo-grid">
      <figure class="demo-figure">
        <div class="demo-media demo-media-video">
          <video
            src="/tykerf-guides/videos/tykerf-tasks.mp4"
            poster="/tykerf-guides/videos/tykerf-tasks.jpg"
            width="1280"
            height="720"
            controls
            playsinline
            preload="none"
            aria-label="Two tasks written on a page about London, then given to Kaity, who changes the skyline's colours and adds a section about The Shard."
          ></video>
        </div>
        <figcaption>
          <strong>TYKERF.</strong> Click what you would change, write a line,
          and give Kaity all your tasks at once. She answers each one when it is
          done (1:40).
          <a class="inline-link" href="/tykerf/#tasks">
            See the tasks
          </a>
          ·
          <a class="inline-link" href="/tykerf/">
            More about TYKERF
          </a>
        </figcaption>
      </figure>
      <figure class="demo-figure">
        <a
          class="demo-media"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens the video in a new tab"
          href="/images/claude-curates-drift.mp4"
        >
          <video
            src="/images/claude-curates-drift.mp4"
            width="1226"
            height="940"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Claude Desktop reads the six photographs of the Drift exhibition through TYDAL, proposes a title and description for each, asks permission to update them, and shows the table of new titles."
          ></video>
        </a>
        <figcaption>
          <strong>TYDAL.</strong> Claude reads an exhibition through its Vault,
          proposes titles and descriptions, and asks before it writes them back.
          <a class="inline-link" href="/tydal/#see-it-work">
            More about TYDAL
          </a>
        </figcaption>
      </figure>
    </div>
  </section>
  <section
    class="section container open-source-section"
    id="open-source"
    aria-labelledby="open-title"
  >
    <div>
      <p class="eyebrow">Built in the open</p>
      <h2 id="open-title">
        Open tools
        <br />
        for working together.
      </h2>
    </div>
    <div>
      <p>
        Every Eonity tool is open source under the{' '}
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://www.apache.org/licenses/LICENSE-2.0"
        >
          Apache License 2.0
        </a>
        . Run them yourself, inspect the code and contribute to their
        development.
      </p>
      <p>
        They work with the AI you choose: connect Claude or another MCP client,
        and it gets the same scoped moves the tools use themselves.
      </p>
      <a
        class="text-link"
        target="_blank"
        rel="noopener noreferrer"
        title="Opens in a new tab"
        href="https://github.com/eonity-org"
      >
        Explore the repositories <span aria-hidden="true">↗</span>
      </a>
      <p>
        <a class="text-link" href="/about/">
          About Eonity <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</SiteLayout>
<script>
  const demoVideo = document.querySelector<HTMLVideoElement>(
    '.demo-figure video[autoplay]',
  );
  if (demoVideo && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Stay still; a click opens the video in a new tab, with the browser's controls.
    demoVideo.removeAttribute('autoplay');
    demoVideo.pause();
  }
</script>
