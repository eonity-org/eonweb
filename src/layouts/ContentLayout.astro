---
import SiteLayout from './SiteLayout.astro';
import PageDate from '../components/PageDate.astro';
interface Props {
  frontmatter: {
    title: string;
    description: string;
    label?: string;
    updated?: Date | string;
  };
}
const { frontmatter } = Astro.props;
---

<SiteLayout
  title={`${frontmatter.title} — TYDAL`}
  description={frontmatter.description}
>
  <article class="container content-page">
    <a class="text-link back-link" href="/">
      ← Back to TYDAL
    </a>
    <p class="eyebrow">{frontmatter.label ?? 'The project'}</p>
    <h1>{frontmatter.title}</h1>
    <p class="content-intro">{frontmatter.description}</p>
    <PageDate date={frontmatter.updated} />
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>
