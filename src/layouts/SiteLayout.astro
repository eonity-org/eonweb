---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import ExternalArrow from '../components/ExternalArrow.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Eonity — Structure and meaning for people and AI.',
  description = 'Eonity builds open-source tools that give AI a clear scope to work in: TYDAL for digital assets, TYKERF for web pages and, soon, TYSET for documents. People stay in the loop.',
} = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) =>
  path.startsWith(prefix) ? 'page' : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const ogImageAlt =
  'The eonity logo above the line “Structure and meaning for people and AI.” and the names TYDAL, TYKERF and TYSET.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      href="/brand/tydal-symbol.png?v=20261003-srgb"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Eonity" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@eonity_org" />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Eonity home">
          <img
            src="/brand/eonity.png?v=20261023"
            width="405"
            height="140"
            alt="Eonity"
          />
        </a>
        <nav aria-label="Main navigation">
          <a href="/tydal/" aria-current={current('/tydal/')}>
            TYDAL
          </a>
          <a href="/tykerf/" aria-current={current('/tykerf/')}>
            TYKERF
          </a>
          <a href="/guides/" aria-current={current('/guides/')}>
            Guides
          </a>
          <a href="/developers/" aria-current={current('/developers/')}>
            Developers
          </a>
          <a href="/about/" aria-current={current('/about/')}>
            About
          </a>
        </nav>
        <a
          class="header-github"
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a class="brand" href="/" aria-label="Eonity home">
            <img
              src="/brand/eonity.png?v=20261023"
              width="405"
              height="140"
              alt="Eonity"
            />
          </a>
          <p>Structure and meaning for people and AI.</p>
        </div>
        <div class="footer-links">
          <a href="/tydal/">TYDAL</a>
          <a href="/tykerf/">TYKERF</a>
          <a href="/guides/">User guides</a>
          <a href="/developers/">Developer docs</a>
          <a href="/about/">About Eonity</a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            title="Opens in a new tab"
            href="https://github.com/eonity-org"
          >
            GitHub <ExternalArrow />
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            title="Opens in a new tab"
            href="https://x.com/eonity_org"
          >
            Follow Eonity on X <ExternalArrow />
          </a>
          <a href="mailto:develop@eonity.org">develop@eonity.org</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © 2026 <a href="/about/">Eonity</a>. Open-source projects under the{' '}
          <a
            target="_blank"
            rel="noopener noreferrer"
            title="Opens in a new tab"
            href="https://www.apache.org/licenses/LICENSE-2.0"
          >
            Apache License 2.0
          </a>
          .
        </span>
        <a
          target="_blank"
          rel="noopener noreferrer"
          title="Opens in a new tab"
          href="https://github.com/eonity-org/eonweb"
        >
          Website source <ExternalArrow />
        </a>
      </div>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const updateHeaderHeight = () => {
      document.documentElement.style.setProperty(
        '--header-height',
        `${header.getBoundingClientRect().height}px`,
      );
    };
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(header);
  }
</script>
